    "custom_liquid_hero": {
      "type": "custom-liquid",
      "name": "t:sections.custom_liquid.presets.custom_liquid.name",
      "settings": {
        "color_scheme": "",
        "separate_section_with_border": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"kodak-hero\">\n\n  <!-- =========================================\n       LEFT : IMAGE GALLERY\n  ========================================== -->\n  <div class=\"kodak-gallery\">\n\n    <!-- MAIN IMAGE : PC / MOBILE -->\n    <picture id=\"kodak-main-picture\">\n\n      <!-- MOBILE MAIN IMAGE -->\n      <source\n        id=\"kodak-mobile-source\"\n        media=\"(max-width: 900px)\"\n        srcset=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_hero.jpg\"\n      >\n\n      <!-- PC MAIN IMAGE -->\n      <img\n        id=\"kodak-main-image\"\n        class=\"kodak-main-image\"\n        src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_hero.jpg\"\n        alt=\"KODAK Mini Shot 2 Retro\"\n      >\n\n    </picture>\n\n\n    <!-- THUMBNAILS -->\n    <div class=\"kodak-thumbnails\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_hero.jpg\"\n        onclick=\"changeKodakImage(this.src)\"\n        alt=\"KODAK Mini Shot 2 Retro\"\n      >\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_main1.jpg\"\n        onclick=\"changeKodakImage(this.src)\"\n        alt=\"KODAK Mini Shot 2 Retro Característica 1\"\n      >\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_main2.jpg\"\n        onclick=\"changeKodakImage(this.src)\"\n        alt=\"KODAK Mini Shot 2 Retro Característica 2\"\n      >\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_main3.jpg\"\n        onclick=\"changeKodakImage(this.src)\"\n        alt=\"KODAK Mini Shot 2 Retro Característica 3\"\n      >\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_main4.jpg\"\n        onclick=\"changeKodakImage(this.src)\"\n        alt=\"KODAK Mini Shot 2 Retro Característica 4\"\n      >\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_main5.jpg\"\n        onclick=\"changeKodakImage(this.src)\"\n        alt=\"KODAK Mini Shot 2 Retro Característica 5\"\n      >\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_main6.jpg\"\n        onclick=\"changeKodakImage(this.src)\"\n        alt=\"KODAK Mini Shot 2 Retro Característica 6\"\n      >\n\n    </div>\n\n  </div>\n\n\n  <!-- =========================================\n       RIGHT : CONTENT\n  ========================================== -->\n  <div class=\"kodak-content\">\n\n\n    <!-- BADGES -->\n    <div class=\"badges\">\n\n      <span class=\"choice\">\n        AMAZON'S CHOICE\n      </span>\n\n      <span class=\"bestseller\">\n        #1 BEST SELLER\n      </span>\n\n    </div>\n\n\n    <!-- PC TITLE -->\n    <h1 class=\"kodak-title-desktop\">\n      [AMAZON] KODAK MINI SHOT 2 RETRO\n    </h1>\n\n\n    <!-- MOBILE TITLE -->\n    <h1 class=\"kodak-title-mobile\">\n      KODAK MINI SHOT 2 RETRO\n    </h1>\n\n\n    <!-- PC DESCRIPTION -->\n    <p class=\"description description-desktop\">\n      CAPTURA TUS MOMENTOS FAVORITOS E IMPRIME FOTOS BRILLANTES DE 2×3\" AL INSTANTE CON LA TECNOLOGÍA KODAK 4PASS. SOLO TIENES QUE HACER LA FOTO, CONECTAR E IMPRIMIR.\n    </p>\n\n\n    <!-- MOBILE DESCRIPTION -->\n    <p class=\"description description-mobile\">\n      Cámara instantánea e impresora fotográfica 2×3\" con tecnología KODAK 4PASS\n    </p>\n\n\n    <!-- AMAZON BUTTON -->\n    <a\n      href=\"#\"\n      class=\"amazon-button\"\n      target=\"_blank\"\n      rel=\"noopener\"\n      onclick=\"gtag('event', 'Click_Amazon');\"\n    >\n      Comprar ahora en Amazon\n    </a>\n\n  </div>\n\n</div>\n\n\n<style>\n\n/* =========================================================\n   ENTIRE HERO — PC\n========================================================= */\n\n.kodak-hero {\n  display: grid;\n  grid-template-columns: 1.1fr 0.9fr;\n  gap: 60px;\n  max-width: 1500px;\n  margin: 0 auto;\n  padding: 60px 40px;\n  background: #f3f4f6;\n  align-items: start;\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   IMAGE GALLERY\n========================================================= */\n\n.kodak-gallery {\n  width: 100%;\n}\n\n#kodak-main-picture {\n  display: block;\n  width: 100%;\n}\n\n.kodak-main-image {\n  display: block;\n  width: 100%;\n  height: auto;\n  object-fit: contain;\n  background: #fff;\n}\n\n\n/* =========================================================\n   THUMBNAILS — PC\n========================================================= */\n\n.kodak-thumbnails {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 8px;\n  margin-top: 10px;\n}\n\n.kodak-thumbnails img {\n  width: 100%;\n  aspect-ratio: 1 / 1;\n  object-fit: cover;\n  cursor: pointer;\n  border: 1px solid #ddd;\n  background: #fff;\n  box-sizing: border-box;\n  transition: border 0.15s ease;\n}\n\n.kodak-thumbnails img:hover {\n  border: 2px solid #f0b51c;\n}\n\n\n/* =========================================================\n   RIGHT CONTENT — PC\n========================================================= */\n\n.kodak-content {\n  padding-top: 30px;\n}\n\n\n/* =========================================================\n   BADGES\n========================================================= */\n\n.badges {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 18px;\n}\n\n.badges span {\n  font-size: 11px;\n  font-weight: 800;\n  padding: 4px 8px;\n  border-radius: 3px;\n  line-height: 1.2;\n}\n\n.choice {\n  background: #f3d229;\n  color: #111;\n}\n\n.bestseller {\n  background: #dc3153;\n  color: #fff;\n}\n\n\n/* =========================================================\n   TITLES\n========================================================= */\n\n.kodak-title-desktop {\n  display: block;\n  font-size: 30px;\n  letter-spacing: 2.5px;\n  margin: 0 0 30px;\n  white-space: nowrap;\n}\n\n.kodak-title-mobile {\n  display: none;\n}\n\n\n/* =========================================================\n   DESCRIPTION\n========================================================= */\n\n.description {\n  font-size: 14px;\n  line-height: 1.7;\n  letter-spacing: 2px;\n  margin: 0 0 40px;\n}\n\n.description-mobile {\n  display: none;\n}\n\n\n/* =========================================================\n   AMAZON BUTTON\n========================================================= */\n\n.amazon-button {\n  display: block;\n  width: 100%;\n  padding: 18px;\n  background: #ef7417;\n  color: #fff;\n  text-align: center;\n  text-decoration: none;\n  border-radius: 999px;\n  font-size: 22px;\n  font-weight: 700;\n  line-height: 1.2;\n  margin-bottom: 0;\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width: 900px) {\n\n  .kodak-hero {\n    display: block;\n    width: 100%;\n    margin: 0;\n    padding: 0 18px 30px;\n    background: #f3f4f6;\n    box-sizing: border-box;\n  }\n\n  .kodak-gallery {\n    width: 100%;\n    margin: 0;\n    padding: 0;\n  }\n\n  #kodak-main-picture {\n    display: block;\n    width: 100%;\n    margin: 0 auto;\n  }\n\n  .kodak-main-image {\n    display: block;\n    width: 100%;\n    height: auto;\n    margin: 0 auto;\n    object-fit: contain;\n  }\n\n  /* THUMBNAILS */\n\n  .kodak-thumbnails {\n    display: flex;\n    width: 100%;\n    gap: 8px;\n    margin: 10px 0 0;\n    padding: 0 0 5px;\n    overflow-x: auto;\n    overflow-y: hidden;\n    scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n    box-sizing: border-box;\n  }\n\n  .kodak-thumbnails::-webkit-scrollbar {\n    display: none;\n  }\n\n  .kodak-thumbnails img {\n    flex: 0 0 calc((100% - 24px) / 4);\n    width: calc((100% - 24px) / 4);\n    min-width: calc((100% - 24px) / 4);\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n    border: 1px solid #ddd;\n    scroll-snap-align: start;\n  }\n\n  /* CONTENT */\n\n  .kodak-content {\n    width: 100%;\n    padding: 0;\n    margin-top: 22px;\n    text-align: center;\n  }\n\n  /* BADGES */\n\n  .badges {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 7px;\n    margin: 0 0 16px;\n  }\n\n  .badges span {\n    font-size: 10px;\n    padding: 5px 8px;\n    border-radius: 3px;\n  }\n\n  /* PC TITLE OFF */\n\n  .kodak-title-desktop {\n    display: none;\n  }\n\n  /* MOBILE TITLE */\n\n  .kodak-title-mobile {\n    display: block;\n    margin: 0;\n    padding: 0;\n    color: #1d1d1f;\n    font-size: 23px;\n    line-height: 1.2;\n    font-weight: 700;\n    letter-spacing: 1.4px;\n    white-space: nowrap;\n  }\n\n  /* PC DESCRIPTION OFF */\n\n  .description-desktop {\n    display: none;\n  }\n\n  /* MOBILE DESCRIPTION */\n\n  .description-mobile {\n    display: block;\n    max-width: 340px;\n    margin: 9px auto 20px;\n    color: #666;\n    font-size: 12px;\n    line-height: 1.5;\n    font-weight: 400;\n    letter-spacing: 0.3px;\n    text-transform: none;\n  }\n\n  /* AMAZON CTA */\n\n  .amazon-button {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    min-height: 52px;\n    margin: 0;\n    padding: 14px 20px;\n    background: #e87524;\n    color: #fff;\n    border-radius: 999px;\n    font-size: 17px;\n    line-height: 1;\n    font-weight: 700;\n    text-decoration: none;\n    box-sizing: border-box;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 390px) {\n\n  .kodak-hero {\n    padding-left: 14px;\n    padding-right: 14px;\n  }\n\n  .kodak-title-mobile {\n    font-size: 21px;\n    letter-spacing: 1px;\n  }\n\n  .badges span {\n    font-size: 9px;\n  }\n\n  .amazon-button {\n    font-size: 16px;\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\nfunction changeKodakImage(imageUrl) {\n\n  var mainImage =\n    document.getElementById('kodak-main-image');\n\n  var mobileSource =\n    document.getElementById('kodak-mobile-source');\n\n  if (mainImage) {\n    mainImage.src = imageUrl;\n  }\n\n  if (mobileSource) {\n    mobileSource.srcset = imageUrl;\n  }\n\n}\n\n</script>",
        "text_alignment": "center"
      }
    },
