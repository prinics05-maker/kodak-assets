    "custom_liquid_ugc": {
      "type": "custom-liquid",
      "name": "t:sections.custom_liquid.presets.custom_liquid.name",
      "settings": {
        "color_scheme": "",
        "separate_section_with_border": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<style>\n\n/* =========================================================\n   SHOPIFY SECTION 여백 제거\n========================================================= */\n\n.shopify-section:has(.kodak-ugc-full) {\n  margin: 0 !important;\n  padding: 0 !important;\n  border: 0 !important;\n}\n\n.shopify-section:has(.kodak-ugc-full) > div {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n}\n\n.shopify-section:has(.kodak-ugc-full) .page-width,\n.shopify-section:has(.kodak-ugc-full) .custom-liquid,\n.shopify-section:has(.kodak-ugc-full) .section,\n.shopify-section:has(.kodak-ugc-full) [class*=\"section-\"][class*=\"-padding\"] {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n}\n\n\n/* =========================================================\n   전체 UGC\n========================================================= */\n\n.kodak-ugc-full {\n  position: relative;\n\n  width: 100vw !important;\n  max-width: 100vw !important;\n\n  margin: 0 calc(50% - 50vw) !important;\n  padding: 0 !important;\n\n  display: block;\n\n  overflow: hidden;\n\n  line-height: 0;\n\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   PC VERSION\n========================================================= */\n\n.kodak-ugc-desktop {\n  display: block;\n\n  width: 100%;\n\n  margin: 0;\n  padding: 0;\n}\n\n\n/* PC TITLE */\n\n.kodak-ugc-title {\n  display: block !important;\n\n  width: 100% !important;\n  max-width: none !important;\n  height: auto !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0 !important;\n}\n\n\n/* PC VIDEO BACKGROUND */\n\n.kodak-ugc-box {\n  position: relative;\n\n  display: block;\n\n  width: 100%;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  overflow: hidden;\n\n  line-height: 0;\n}\n\n\n.kodak-ugc-box-bg {\n  display: block !important;\n\n  width: 100% !important;\n  max-width: none !important;\n  height: auto !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0 !important;\n}\n\n\n/* =========================================================\n   PC 7 VIDEOS\n========================================================= */\n\n.kodak-video-overlay {\n  position: absolute;\n\n  left: 2.75%;\n  right: 2.75%;\n\n  top: 4.5%;\n  bottom: 5.5%;\n\n  display: flex;\n\n  gap: 1.42%;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  z-index: 5;\n\n  line-height: normal;\n}\n\n\n.kodak-video-card {\n  flex: 0 0 calc((100% - 8.52%) / 7);\n\n  height: 100%;\n  min-width: 0;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  overflow: hidden;\n\n  border-radius: 12px;\n\n  background: transparent;\n}\n\n\n.kodak-video-card video {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  object-fit: cover;\n\n  border: 0;\n\n  border-radius: 12px;\n\n  background: transparent;\n}\n\n\n/* =========================================================\n   MOBILE 기본 숨김\n========================================================= */\n\n.kodak-mobile-ugc {\n  display: none;\n}\n\n\n/* =========================================================\n   MOBILE ONLY\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  /* PC UGC 숨김 */\n\n  .kodak-ugc-desktop {\n    display: none !important;\n  }\n\n\n  /* =======================================================\n     MOBILE UGC\n  ======================================================= */\n\n  .kodak-mobile-ugc {\n    display: block !important;\n\n    width: 100vw !important;\n    max-width: 100vw !important;\n\n    margin: 0 calc(50% - 50vw) !important;\n\n    padding: 0 !important;\n\n    background: #ffe7a0;\n\n    overflow: hidden;\n\n    box-sizing: border-box;\n\n    line-height: normal;\n  }\n\n\n  .kodak-mobile-ugc-inner {\n    width: 100%;\n\n    padding: 17px 18px 17px;\n\n    box-sizing: border-box;\n  }\n\n\n  /* =======================================================\n     MOBILE TITLE IMAGE\n  ======================================================= */\n\n  .kodak-mobile-ugc-title-image {\n    display: block;\n\n    width: 100%;\n    height: auto;\n\n    margin: 0;\n    padding: 0;\n\n    border: 0;\n  }\n\n\n  /* =======================================================\n     MOBILE 3 VIDEO GRID\n  ======================================================= */\n\n  .kodak-mobile-video-grid {\n    display: grid;\n\n    grid-template-columns:\n      repeat(3, minmax(0, 1fr));\n\n    gap: 11px;\n\n    width: 100%;\n\n    margin-top: 0;\n\n    padding: 0;\n\n    box-sizing: border-box;\n  }\n\n\n  /* =======================================================\n     MOBILE VIDEO CARD\n  ======================================================= */\n\n  .kodak-mobile-video-card {\n    position: relative;\n\n    width: 100%;\n\n    aspect-ratio: 9 / 16;\n\n    margin: 0;\n    padding: 0;\n\n    overflow: hidden;\n\n    border-radius: 12px;\n\n    background: #fff;\n\n    box-sizing: border-box;\n  }\n\n\n  .kodak-mobile-video-card video {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    margin: 0;\n    padding: 0;\n\n    object-fit: cover;\n\n    border: 0;\n\n    border-radius: inherit;\n\n    background: #fff;\n  }\n\n\n  /* =======================================================\n     NAVIGATION\n  ======================================================= */\n\n  .kodak-mobile-navigation {\n    display: grid;\n\n    grid-template-columns:\n      44px\n      1fr\n      44px;\n\n    align-items: center;\n\n    width: 100%;\n\n    margin-top: 8px;\n\n    padding: 0;\n  }\n\n\n  /* ARROW */\n\n  .kodak-mobile-nav-button {\n    display: flex;\n\n    align-items: center;\n    justify-content: center;\n\n    width: 44px;\n    height: 44px;\n\n    margin: 0;\n    padding: 0;\n\n    border: 0;\n\n    background: transparent;\n\n    color: #65583d;\n\n    font-family: Arial, sans-serif;\n\n    font-size: 35px;\n\n    font-weight: 400;\n\n    line-height: 1;\n\n    cursor: pointer;\n\n    -webkit-tap-highlight-color: transparent;\n  }\n\n\n  /* DOTS */\n\n  .kodak-mobile-dots {\n    display: flex;\n\n    align-items: center;\n    justify-content: center;\n\n    gap: 7px;\n  }\n\n\n  .kodak-mobile-dot {\n    display: block;\n\n    width: 8px;\n    height: 8px;\n\n    min-width: 8px;\n\n    margin: 0;\n    padding: 0;\n\n    border: 0;\n\n    border-radius: 50%;\n\n    background: rgba(70, 58, 35, 0.28);\n\n    cursor: pointer;\n\n    -webkit-tap-highlight-color: transparent;\n  }\n\n\n  .kodak-mobile-dot.active {\n    background: #5c5037;\n  }\n\n}\n\n\n/* =========================================================\n   아주 작은 모바일\n========================================================= */\n\n@media screen and (max-width: 390px) {\n\n  .kodak-mobile-ugc-inner {\n    padding-left: 14px;\n    padding-right: 14px;\n  }\n\n  .kodak-mobile-video-grid {\n    gap: 8px;\n  }\n\n}\n\n</style>\n\n\n\n<div class=\"kodak-ugc-full\">\n\n\n  <!-- =====================================================\n       PC VERSION\n  ====================================================== -->\n\n  <div class=\"kodak-ugc-desktop\">\n\n\n    <!-- PC TITLE IMAGE -->\n\n    <img\n      class=\"kodak-ugc-title\"\n      src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_title.jpg\"\n      alt=\"See Why Customers Love It!\"\n    >\n\n\n    <!-- PC VIDEO SECTION -->\n\n    <div class=\"kodak-ugc-box\">\n\n\n      <!-- 7 WHITE BOX BACKGROUND -->\n\n      <img\n        class=\"kodak-ugc-box-bg\"\n        src=\"https://cdn.shopify.com/s/files/1/0484/6180/7774/files/PC_03-2.jpg\"\n        alt=\"\"\n      >\n\n\n      <!-- PC VIDEOS -->\n\n      <div class=\"kodak-video-overlay\">\n\n\n        <!-- 01 -->\n\n        <div class=\"kodak-video-card\">\n\n          <video\n            src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v1.mp4\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n        <!-- 02 -->\n\n        <div class=\"kodak-video-card\">\n\n          <video\n            src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v2.mp4\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n        <!-- 03 -->\n\n        <div class=\"kodak-video-card\">\n\n          <video\n            src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v3.mp4\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n        <!-- 04 -->\n\n        <div class=\"kodak-video-card\">\n\n          <video\n            src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v4.mp4\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n        <!-- 05 -->\n\n        <div class=\"kodak-video-card\">\n\n          <video\n            src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v5.mp4\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n        <!-- 06 -->\n\n        <div class=\"kodak-video-card\">\n\n          <video\n            src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v6.mp4\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n        <!-- 07 -->\n\n        <div class=\"kodak-video-card\">\n\n          <video\n            src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v7.mp4\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n      </div>\n\n    </div>\n\n  </div>\n\n\n\n  <!-- =====================================================\n       MOBILE VERSION\n  ====================================================== -->\n\n  <div class=\"kodak-mobile-ugc\">\n\n\n    <div class=\"kodak-mobile-ugc-inner\">\n\n\n      <!-- MOBILE TITLE IMAGE -->\n\n      <img\n        class=\"kodak-mobile-ugc-title-image\"\n        src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_title.jpg\"\n        alt=\"See Why Customers Love It!\"\n      >\n\n\n      <!-- =================================================\n           MOBILE VIDEO CARDS\n      ================================================== -->\n\n      <div class=\"kodak-mobile-video-grid\">\n\n\n        <!-- MOBILE VIDEO 01 -->\n\n        <div class=\"kodak-mobile-video-card\">\n\n          <video\n            id=\"kodak-m-video-1\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n        <!-- MOBILE VIDEO 02 -->\n\n        <div class=\"kodak-mobile-video-card\">\n\n          <video\n            id=\"kodak-m-video-2\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n        <!-- MOBILE VIDEO 03 -->\n\n        <div class=\"kodak-mobile-video-card\">\n\n          <video\n            id=\"kodak-m-video-3\"\n            playsinline\n            muted\n            loop\n            controls\n            preload=\"metadata\">\n          </video>\n\n        </div>\n\n\n      </div>\n\n\n\n      <!-- =================================================\n           MOBILE NAVIGATION\n      ================================================== -->\n\n      <div class=\"kodak-mobile-navigation\">\n\n\n        <!-- PREVIOUS -->\n\n        <button\n          class=\"kodak-mobile-nav-button\"\n          id=\"kodak-mobile-prev\"\n          type=\"button\"\n          aria-label=\"Previous videos\">\n          ‹\n        </button>\n\n\n        <!-- DOTS -->\n\n        <div class=\"kodak-mobile-dots\">\n\n\n          <button\n            class=\"kodak-mobile-dot active\"\n            data-page=\"0\"\n            type=\"button\"\n            aria-label=\"Video page 1\">\n          </button>\n\n\n          <button\n            class=\"kodak-mobile-dot\"\n            data-page=\"1\"\n            type=\"button\"\n            aria-label=\"Video page 2\">\n          </button>\n\n\n          <button\n            class=\"kodak-mobile-dot\"\n            data-page=\"2\"\n            type=\"button\"\n            aria-label=\"Video page 3\">\n          </button>\n\n\n        </div>\n\n\n        <!-- NEXT -->\n\n        <button\n          class=\"kodak-mobile-nav-button\"\n          id=\"kodak-mobile-next\"\n          type=\"button\"\n          aria-label=\"Next videos\">\n          ›\n        </button>\n\n\n      </div>\n\n\n    </div>\n\n  </div>\n\n\n</div>\n\n\n\n<script>\n\n(function () {\n\n\n  /* =====================================================\n     VIDEO URLS\n  ===================================================== */\n\n  const kodakVideoUrls = [\n\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v1.mp4\",\n\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v2.mp4\",\n\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v3.mp4\",\n\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v4.mp4\",\n\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v5.mp4\",\n\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v6.mp4\",\n\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/test_c210r_es_v7.mp4\"\n\n  ];\n\n\n  /* =====================================================\n     MOBILE PAGES\n  ===================================================== */\n\n  const kodakPages = [\n\n    [0, 1, 2],\n\n    [3, 4, 5],\n\n    [6, 0, 1]\n\n  ];\n\n\n  let kodakCurrentPage = 0;\n\n\n  /* =====================================================\n     INIT\n  ===================================================== */\n\n  function initKodakUGC() {\n\n\n    const root =\n      document.querySelector(\".kodak-ugc-full\");\n\n\n    if (!root) {\n      return;\n    }\n\n\n    const mobileVideos = [\n\n      root.querySelector(\"#kodak-m-video-1\"),\n\n      root.querySelector(\"#kodak-m-video-2\"),\n\n      root.querySelector(\"#kodak-m-video-3\")\n\n    ];\n\n\n    const prevButton =\n      root.querySelector(\"#kodak-mobile-prev\");\n\n\n    const nextButton =\n      root.querySelector(\"#kodak-mobile-next\");\n\n\n    const dots =\n      root.querySelectorAll(\".kodak-mobile-dot\");\n\n\n    /* ===================================================\n       UPDATE MOBILE VIDEOS\n    =================================================== */\n\n    function updateMobileVideos() {\n\n\n      const currentVideos =\n        kodakPages[kodakCurrentPage];\n\n\n      mobileVideos.forEach(\n        function(video, index) {\n\n\n          if (!video) {\n            return;\n          }\n\n\n          video.pause();\n\n\n          const newUrl =\n            kodakVideoUrls[\n              currentVideos[index]\n            ];\n\n\n          if (\n            video.getAttribute(\"src\") !==\n            newUrl\n          ) {\n\n\n            video.setAttribute(\n              \"src\",\n              newUrl\n            );\n\n\n            video.load();\n\n          }\n\n        }\n      );\n\n\n      dots.forEach(\n        function(dot, index) {\n\n\n          dot.classList.toggle(\n            \"active\",\n            index === kodakCurrentPage\n          );\n\n\n        }\n      );\n\n    }\n\n\n    /* ===================================================\n       PREVIOUS\n    =================================================== */\n\n    if (\n      prevButton &&\n      prevButton.dataset.ready !== \"true\"\n    ) {\n\n\n      prevButton.dataset.ready = \"true\";\n\n\n      prevButton.addEventListener(\n        \"click\",\n        function () {\n\n\n          kodakCurrentPage--;\n\n\n          if (\n            kodakCurrentPage < 0\n          ) {\n\n            kodakCurrentPage =\n              kodakPages.length - 1;\n\n          }\n\n\n          updateMobileVideos();\n\n        }\n      );\n\n    }\n\n\n    /* ===================================================\n       NEXT\n    =================================================== */\n\n    if (\n      nextButton &&\n      nextButton.dataset.ready !== \"true\"\n    ) {\n\n\n      nextButton.dataset.ready = \"true\";\n\n\n      nextButton.addEventListener(\n        \"click\",\n        function () {\n\n\n          kodakCurrentPage++;\n\n\n          if (\n            kodakCurrentPage >=\n            kodakPages.length\n          ) {\n\n            kodakCurrentPage = 0;\n\n          }\n\n\n          updateMobileVideos();\n\n        }\n      );\n\n    }\n\n\n    /* ===================================================\n       DOT CLICK\n    =================================================== */\n\n    dots.forEach(\n      function(dot) {\n\n\n        if (\n          dot.dataset.ready === \"true\"\n        ) {\n\n          return;\n\n        }\n\n\n        dot.dataset.ready = \"true\";\n\n\n        dot.addEventListener(\n          \"click\",\n          function () {\n\n\n            const page =\n              Number(\n                dot.dataset.page\n              );\n\n\n            if (\n              Number.isNaN(page)\n            ) {\n\n              return;\n\n            }\n\n\n            kodakCurrentPage =\n              page;\n\n\n            updateMobileVideos();\n\n          }\n        );\n\n\n      }\n    );\n\n\n    /* ===================================================\n       ONE VIDEO AT A TIME\n    =================================================== */\n\n    root\n      .querySelectorAll(\"video\")\n      .forEach(\n        function(video) {\n\n\n          if (\n            video.dataset.pauseReady ===\n            \"true\"\n          ) {\n\n            return;\n\n          }\n\n\n          video.dataset.pauseReady =\n            \"true\";\n\n\n          video.addEventListener(\n            \"play\",\n            function () {\n\n\n              root\n                .querySelectorAll(\"video\")\n                .forEach(\n                  function(otherVideo) {\n\n\n                    if (\n                      otherVideo !== video\n                    ) {\n\n                      otherVideo.pause();\n\n                    }\n\n\n                  }\n                );\n\n\n            }\n          );\n\n\n        }\n      );\n\n\n    /* FIRST LOAD */\n\n    updateMobileVideos();\n\n  }\n\n\n  /* =====================================================\n     REMOVE SHOPIFY SECTION SPACING\n  ===================================================== */\n\n  function removeKodakSpacing() {\n\n\n    document\n      .querySelectorAll(\".kodak-ugc-full\")\n      .forEach(\n        function(ugc) {\n\n\n          const section =\n            ugc.closest(\".shopify-section\");\n\n\n          if (!section) {\n            return;\n          }\n\n\n          section.style.setProperty(\n            \"padding-top\",\n            \"0px\",\n            \"important\"\n          );\n\n\n          section.style.setProperty(\n            \"padding-bottom\",\n            \"0px\",\n            \"important\"\n          );\n\n\n          section.style.setProperty(\n            \"margin-top\",\n            \"0px\",\n            \"important\"\n          );\n\n\n          section.style.setProperty(\n            \"margin-bottom\",\n            \"0px\",\n            \"important\"\n          );\n\n\n          const wrappers =\n            section.querySelectorAll(\n              '.page-width, .section, .custom-liquid, [class*=\"section-\"][class*=\"-padding\"]'\n            );\n\n\n          wrappers.forEach(\n            function(wrapper) {\n\n\n              wrapper.style.setProperty(\n                \"padding-top\",\n                \"0px\",\n                \"important\"\n              );\n\n\n              wrapper.style.setProperty(\n                \"padding-bottom\",\n                \"0px\",\n                \"important\"\n              );\n\n\n              wrapper.style.setProperty(\n                \"margin-top\",\n                \"0px\",\n                \"important\"\n              );\n\n\n              wrapper.style.setProperty(\n                \"margin-bottom\",\n                \"0px\",\n                \"important\"\n              );\n\n\n            }\n          );\n\n\n        }\n      );\n\n  }\n\n\n  /* =====================================================\n     RUN\n  ===================================================== */\n\n  function runKodakUGC() {\n\n    removeKodakSpacing();\n\n    initKodakUGC();\n\n  }\n\n\n  if (\n    document.readyState ===\n    \"loading\"\n  ) {\n\n\n    document.addEventListener(\n      \"DOMContentLoaded\",\n      runKodakUGC\n    );\n\n\n  } else {\n\n\n    runKodakUGC();\n\n\n  }\n\n\n  /* SHOPIFY THEME EDITOR */\n\n  document.addEventListener(\n    \"shopify:section:load\",\n    runKodakUGC\n  );\n\n\n  document.addEventListener(\n    \"shopify:section:select\",\n    runKodakUGC\n  );\n\n\n  setTimeout(\n    runKodakUGC,\n    300\n  );\n\n\n  setTimeout(\n    runKodakUGC,\n    1000\n  );\n\n\n})();\n\n</script>",
        "text_alignment": "center"
      }
    },
