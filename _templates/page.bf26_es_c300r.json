ttps://cdn.shopify.com/s/files/1/0786/1610/1198/files/bf26_c300r_es_v07.mp4#t=0.1\" playsinline muted loop controls preload=\"metadata\"></video>\n    </div>\n  </div>\n  <div class=\"bf26-ugc-box bf26-ugc-mo\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/bf26_c300r_es_ugcbg_mo.png?width=1100\" alt=\"\" width=\"1100\" height=\"809\" loading=\"lazy\">\n    <div class=\"bf26-ugc-card\" style=\"left:4.1818%;top:25.7108%;width:27.8182%;height:66.8727%;\">\n      <video class=\"bf26-m-video\" playsinline muted loop controls preload=\"metadata\"></video>\n    </div>\n    <div class=\"bf26-ugc-card\" style=\"left:36.1818%;top:25.7108%;width:27.8182%;height:66.8727%;\">\n      <video class=\"bf26-m-video\" playsinline muted loop controls preload=\"metadata\"></video>\n    </div>\n    <div class=\"bf26-ugc-card\" style=\"left:68.0909%;top:25.7108%;width:27.8182%;height:66.8727%;\">\n      <video class=\"bf26-m-video\" playsinline muted loop controls preload=\"metadata\"></video>\n    </div>\n    <button class=\"bf26-nav bf26-prev\" type=\"button\" aria-label=\"Previous\">&#8249;</button>\n    <button class=\"bf26-nav bf26-next\" type=\"button\" aria-label=\"Next\">&#8250;</button>\n    <div class=\"bf26-dots\"><button class=\"bf26-dot active\" data-page=\"0\" type=\"button\" aria-label=\"Page 1\"></button><button class=\"bf26-dot\" data-page=\"1\" type=\"button\" aria-label=\"Page 2\"></button><button class=\"bf26-dot\" data-page=\"2\" type=\"button\" aria-label=\"Page 3\"></button></div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var urls = [\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/bf26_c300r_es_v01.mp4#t=0.1\",\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/bf26_c300r_es_v02.mp4#t=0.1\",\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/bf26_c300r_es_v03.mp4#t=0.1\",\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/bf26_c300r_es_v04.mp4#t=0.1\",\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/bf26_c300r_es_v05_h264.mp4#t=0.1\",\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/bf26_c300r_es_v06.mp4#t=0.1\",\n    \"https://cdn.shopify.com/s/files/1/0786/1610/1198/files/bf26_c300r_es_v07.mp4#t=0.1\"\n  ];\n  function init() {\n    var root = document.querySelector(\".bf26-ugc\");\n    if (!root || root.dataset.ready === \"true\") return;\n    root.dataset.ready = \"true\";\n    root.querySelectorAll(\"video\").forEach(function (v) {\n      v.addEventListener(\"play\", function () {\n        root.querySelectorAll(\"video\").forEach(function (o) { if (o !== v) o.pause(); });\n      });\n    });\n    if (!urls.length) return;\n    var mv = root.querySelectorAll(\".bf26-m-video\");\n    var dots = root.querySelectorAll(\".bf26-dot\");\n    var pages = Math.ceil(urls.length / 3), page = 0;\n    function show() {\n      mv.forEach(function (v, i) {\n        var u = urls[(page * 3 + i) % urls.length];\n        v.pause();\n        if (v.getAttribute(\"src\") !== u) { v.setAttribute(\"src\", u); v.load(); }\n      });\n      dots.forEach(function (d, i) { d.classList.toggle(\"active\", i === page); });\n    }\n    var prev = root.querySelector(\".bf26-prev\"), next = root.querySelector(\".bf26-next\");\n    if (prev) prev.addEventListener(\"click\", function () { page = (page - 1 + pages) % pages; show(); });\n    if (next) next.addEventListener(\"click\", function () { page = (page + 1) % pages; show(); });\n    dots.forEach(function (d) { d.addEventListener(\"click\", function () { page = Number(d.dataset.page) || 0; show(); }); });\n    var box = root.querySelector(\".bf26-ugc-mo\"), sx = null;\n    if (box) {\n      box.addEventListener(\"touchstart\", function (e) { sx = e.touches[0].clientX; }, { passive: true });\n      box.addEventListener(\"touchend\", function (e) {\n        if (sx === null) return;\n        var dx = e.changedTouches[0].clientX - sx; sx = null;\n        if (Math.abs(dx) > 40) { page = (page + (dx < 0 ? 1 : -1) + pages) % pages; show(); }\n      });\n    }\n    show();\n  }\n  if (document.readyState === \"loading\") document.addEventListener(\"DOMContentLoaded\", init); else init();\n  document.addEventListener(\"shopify:section:load\", function () {\n    var r = document.querySelector(\".bf26-ugc\"); if (r) r.dataset.ready = \"\"; init();\n  });\n})();\n</script>",
