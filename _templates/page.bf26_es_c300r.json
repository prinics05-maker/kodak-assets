        "liquid": "<style>\n.shopify-section:has(.bf26-ugc) { margin: 0 !important; padding: 0 !important; border: 0 !important; }\n.shopify-section:has(.bf26-ugc) .page-width,\n.shopify-section:has(.bf26-ugc) .section,\n.shopify-section:has(.bf26-ugc) .custom-liquid,\n.shopify-section:has(.bf26-ugc) [class*=\"section-\"][class*=\"-padding\"] { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }\n.bf26-ugc { width: 100vw !important; max-width: 100vw !important; margin: 0 calc(50% - 50vw) !important; padding: 0 !important; line-height: 0; }\n.bf26-ugc-box { position: relative; width: 100%; line-height: 0; }\n.bf26-ugc-box > img { display: block; width: 100% !important; max-width: none !important; height: auto !important; margin: 0 !important; border: 0 !important; }\n.bf26-ugc-card { position: absolute; overflow: hidden; border-radius: 9.45% / 5.36%; background: #000; line-height: normal; }\n.bf26-ugc-card video { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; background: #000; }\n.bf26-ugc-mo { display: none; }\n.bf26-nav { position: absolute; top: 47.2%; z-index: 3; width: 34px; height: 34px; margin-top: -17px; padding: 0; border: 0; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; font: 400 26px/32px Arial, sans-serif; cursor: pointer; -webkit-tap-highlight-color: transparent; }\n.bf26-prev { left: 1.2%; }\n.bf26-next { right: 1.2%; }\n.bf26-dots { position: absolute; left: 0; right: 0; top: 96.3%; transform: translateY(-50%); z-index: 3; display: flex; justify-content: center; gap: 7px; line-height: 0; }\n.bf26-dot { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 50%; background: rgba(255,255,255,.35); cursor: pointer; }\n.bf26-dot.active { background: #fff; }\n@media screen and (max-width: 699px) {\n  .bf26-ugc-pc { display: none; }\n  .bf26-ugc-mo { display: block; }\n}\n</style>\n\n<div class=\"bf26-ugc\">\n  <div class=\"bf26-ugc-box bf26-ugc-p